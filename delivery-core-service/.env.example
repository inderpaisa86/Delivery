# =============================================
# Variables de entorno - Copiar a .env y configurar
# =============================================

# Perfil: dev o prod
SPRING_PROFILES_ACTIVE=dev

# Servidor
SERVER_PORT=8080

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/delivery_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=mi-token-secreto
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Seguridad
APP_API_TOKEN=delivery-internal-token
TRACKING_SECRET=tracking-secret-key

# Rate limiting
RATE_LIMIT_WEBHOOK=60
